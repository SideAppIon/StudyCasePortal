rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() { return request.auth != null; }
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userExists() { return isLoggedIn() && exists(userDocPath()); }
    function getUser() { return get(userDocPath()); }
    function isAdmin()   { return userExists() && getUser().data.role == 'admin'; }
    function isTeacher() { return userExists() && getUser().data.role == 'teacher'; }
    function isStudent() { return userExists() && getUser().data.role == 'student'; }

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /groups/{groupId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /grades/{gradeId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Достижения
    match /achievements/{achId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Попытки тестов
    match /quiz_attempts/{attemptId} {
      allow read: if isLoggedIn() && (
        isAdmin() || isTeacher() ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isLoggedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
      match /enrollments/{userId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
      }
      match /topics/{topicId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
        match /access/{userId} {
          allow read: if isLoggedIn();
          allow write: if isAdmin();
        }
      }
    }

    match /answers/{answerId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && request.auth.uid == resource.data.authorId;
    }
  }
}
